# Banco de Dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=biblioteca
DB_USER=postgres
DB_PASSWORD=sua_senha

# WhatsApp Baileys
SESSION_NAME=biblioteca-bot

# Agendamento (cron expression)
# Padrão: todo dia às 9h da manhã
CRON_SCHEDULE=0 9 * * *

# Horário para lembrete de 1 dia antes (cron expression)
# Padrão: todo dia às 10h da manhã
CRON_REMINDER_SCHEDULE=0 10 * * *